# Nexus Quantum Cloud Configuration
# Relational Database (Prisma ORM with SQLite for zero-config local execution)
DATABASE_URL="file:./dev.db"

# Optional: PostgreSQL Connection (uncomment to switch to PostgreSQL)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_ledger?schema=public"

# Transactional Email (Resend API)
# Leave blank to operate in High-Fidelity Local Simulation Mode
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_WEBHOOK_SECRET="whsec_placeholder_verification_key"

# Edge Middleware & Session Auth
SESSION_SECRET="your_secure_random_session_secret_jwt_key_here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hybrid Telemetry Store (Mongoose / MongoDB)
MONGODB_URI="mongodb://localhost:27017/nexus_telemetry"
